# HTTPS with an automatic certificate for WORKTREE_DOMAIN. Caddy passes
# WebSocket upgrades and large push bodies through without extra settings.
{$WORKTREE_DOMAIN} {
	# Counters for monitoring only; scrape them inside the network.
	@internal path /_worktree/metrics
	respond @internal 404

	reverse_proxy worktree:8080 {
		health_uri /_worktree/health
		health_interval 5s
	}
}
