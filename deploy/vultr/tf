#!/usr/bin/env bash
# Runs OpenTofu with the Vultr API key and the S3 keys of the state bucket.
# The API key comes from VULTR_API_KEY or ~/.vultr-cli.yaml.
set -euo pipefail
cd "$(dirname "$0")"
if [[ -z "${VULTR_API_KEY:-}" ]]; then
  VULTR_API_KEY=$(sed -n 's/^api-key: *//p' ~/.vultr-cli.yaml)
fi
export VULTR_API_KEY
# Cloudflare API token (Zone Read, DNS Edit) for the DNS record. Commands
# that read only outputs work without it.
if [[ -z "${CLOUDFLARE_API_TOKEN:-}" && -f .secrets/cloudflare-token ]]; then
  export CLOUDFLARE_API_TOKEN=$(<.secrets/cloudflare-token)
fi
# The Object Storage subscription with the state bucket (label "rustgit").
eval "$(vultr-cli object-storage list -o json | python3 -c '
import json, shlex, sys
for o in json.load(sys.stdin)["object_storages"]:
    if o["label"] == "rustgit":
        print("export AWS_ACCESS_KEY_ID=" + shlex.quote(o["s3_access_key"]))
        print("export AWS_SECRET_ACCESS_KEY=" + shlex.quote(o["s3_secret_key"]))
        break
else:
    sys.exit("no Object Storage labeled rustgit")
')"
exec tofu "$@"
